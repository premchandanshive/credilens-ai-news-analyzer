# CrediLens Backend Environment Variables
APP_NAME=CrediLens
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

# MongoDB Database URI (MongoDB Atlas or local; falls back to in-memory if empty)
MONGODB_URI=
MONGODB_DB=credilens

# JWT Secret for User Session Signing
JWT_SECRET=credilens-academic-ai-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# External Fact-Checking & Search API Keys (Optional; falls back to Wikipedia & DDG)
TAVILY_API_KEY=
SERPER_API_KEY=

# Analysis Engine Settings
MAX_CLAIMS=6
ENABLE_TRANSFORMER=false
